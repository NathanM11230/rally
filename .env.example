SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Lesson times are interpreted in this timezone when forms and reminder text render.
LESSON_TIME_ZONE=America/New_York

# Signup is closed unless at least one of these is set.
# SIGNUP_INVITE_CODE lets approved pros create accounts with a shared club code.
# SIGNUP_ALLOWED_EMAILS is a comma-separated allowlist of pro emails.
SIGNUP_INVITE_CODE=
SIGNUP_ALLOWED_EMAILS=

# Required for signed calendar download links that work from phone calendar apps.
CALENDAR_TOKEN_SECRET=
