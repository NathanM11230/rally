{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": ".test-build",
    "noEmit": false
  },
  "include": [
    "lib/auth-rate-limit.ts",
    "lib/calendar-token.ts",
    "lib/signup-access.ts",
    "tests/**/*.test.ts"
  ]
}
